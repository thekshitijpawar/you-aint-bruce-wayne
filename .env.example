# Environment Variables Template
# Copy this file to .env or .env.local for local configuration.
# DO NOT commit real API keys or secrets to git!

# Partner Household Sync Endpoint
VITE_PARTNER_SYNC_URL=https://brucewayne-sync-default-rtdb.firebaseio.com/rooms

# Supabase Configuration (Optional - Client-side public keys ONLY with Row-Level Security enabled)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Stripe Public Key (Optional - Client-side publishable key ONLY)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
